# Конфигурация wakode. Все ключи необязательны: пропущенное берётся из
# умолчаний, а любое значение перебивается переменной окружения
# WAKODE_<СЕКЦИЯ>_<КЛЮЧ> — она старше файла.
#
# Неизвестный ключ — ошибка старта, а не молчаливое игнорирование:
# опечатка в имени иначе выглядела бы как «настройка не подействовала».

[server]
# Петлевой адрес по умолчанию. Инстанс, выставленный наружу, должен быть
# выставлен осознанно. За обратным прокси менять не нужно — прокси сам
# ходит на 127.0.0.1.
listen = "127.0.0.1:9000"

# Адрес, по которому инстанс виден снаружи. Уезжает в ссылки, поэтому
# здесь настоящее имя с https, а не localhost.
public_url = "https://wakode.example.org"

[database]
path = "/var/lib/wakode/wakode.db"

# Глубина очереди пишущей задачи. Переполнение превращается в 503 с
# Retry-After, и плагин редактора дошлёт отметки из своей очереди — это
# лучше, чем копить их в памяти сервера.
write_queue = 256

[auth]
# Самостоятельная регистрация. Для личного инстанса не нужна: учётки
# заводятся командой `wakode user create`.
registration = false

session_ttl_days = 30

# Разрешить первичную настройку с любого адреса.
#
# Оставляйте false. За обратным прокси адрес клиента серверу неизвестен —
# TCP-пиром всегда оказывается сам прокси, — и вместо этого флага есть
# одноразовый токен: он печатается в журнал при старте, пока
# администратора нет, и предъявляется заголовком x-wakode-setup-token.
#
#   journalctl -u wakode | grep token=
#
# true открывает экран первичной настройки всем, кто дотянется до порта,
# — до создания первого пользователя.
setup_from_any_address = false

[durations]
# Порог, после которого пауза считается концом сессии, а не паузой внутри
# неё. 900 секунд — то же значение, что у WakaTime.
timeout_secs = 900

# Добавка последней отметке сессии. Ноль до калибровки по живому аккаунту
# WakaTime: величина нигде не задокументирована. С нулём wakode
# недосчитывает хвост каждой сессии — работать это не мешает, совпасть
# цифрам с WakaTime мешает.
tail_padding_secs = 0
