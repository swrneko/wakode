# Окружение сервиса. Права 0600, владелец root: systemd читает файл сам,
# а сервису он не нужен.
#
# Мастер-ключ шифрует API-ключи в базе. Потеряете — выданные ключи станут
# нечитаемы, и их придётся перевыпустить. Получить новый:
#
#   wakode master-key generate
#
WAKODE_MASTER_KEY=

# Что писать в журнал. `info` — боевое значение; на нём видны запросы,
# старт, останов и отказы. `debug` добавит подробности запросов.
RUST_LOG=info
